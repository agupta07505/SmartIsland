    <string name="gesture_1_tap_title">Toque Único</string>
    <string name="gesture_1_tap_sub">Expandir / Recolher</string>
    <string name="gesture_1_tap_desc">Toque na pílula flutuante para expandi-la em cartões de widgets interativos. Toque em um cartão expandido para abrir o aplicativo correspondente diretamente.</string>
    <string name="gesture_2_swipe_up_title">Deslizar Rápido para Cima</string>
    <string name="gesture_2_swipe_up_sub">Dispensar Notificação Atual</string>
    <string name="gesture_2_swipe_up_desc">Deslize rapidamente para cima no cartão da ilha expandida para dispensar o alerta de notificação visível e retornar à pílula recolhida.</string>
